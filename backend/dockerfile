# ---- Tahap 1: Builder ----
FROM python:3.11-slim AS builder

WORKDIR /app

# Instal dependensi sistem untuk build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Buat virtual environment
RUN python -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH"

COPY requirements.txt .

# PERBAIKAN UTAMA:
# Menggunakan --extra-index-url memastikan bahwa saat mendeteksi dependensi dari requirements.txt (seperti ultralytics), 
# pip akan memprioritaskan mencari versi CPU dari server PyTorch, bukan versi GPU dari PyPI standar.
RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -r requirements.txt

# ---- Tahap 2: Produksi ----
FROM python:3.11-slim AS production

WORKDIR /app

# Salin venv dari builder
COPY --from=builder /app/venv /app/venv

# Runtime dependencies untuk OpenCV/Ultralytics pada image slim.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Konfigurasi Environment
ENV PATH="/app/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=7860

# Keamanan: User non-root
RUN useradd --create-home appuser
USER appuser
WORKDIR /home/appuser/app

# Salin kode aplikasi dengan hak akses user non-root
COPY --chown=appuser:appuser . .

EXPOSE 7860

CMD ["supervisord", "-c", "/home/appuser/app/supervisord.conf"]